{
  "datasets": [
    {
      "name": "headline",
      "displayName": "Headline numbers",
      "queryLines": [
        "select\n",
        "  (select round(sum(on_schedule_qty) / sum(scheduled_qty), 3) from workspace.sc_gold.kpi_schedule_adherence\n",
        "     where week_start >= (select date_sub(max(week_start), 21) from workspace.sc_gold.kpi_schedule_adherence)) as adherence_last_4_weeks,\n",
        "  (select min(adherence) from (select week_start, sum(on_schedule_qty) / sum(scheduled_qty) as adherence\n",
        "     from workspace.sc_gold.kpi_schedule_adherence group by week_start)) as worst_week_adherence,\n",
        "  (select count(*) from workspace.sc_gold.kpi_stockout_risk) as materials_at_risk_today,\n",
        "  (select count(*) from workspace.sc_gold.fct_purchase_lines\n",
        "     where not is_fully_received and promised_date < (select max(date_day) from workspace.sc_gold.kpi_stock_coverage)) as overdue_order_lines,\n",
        "  (select round(sum(lines_on_time) / sum(lines_completed), 3) from workspace.sc_gold.kpi_supplier_performance) as supplier_on_time_rate,\n",
        "  (select count(*) from workspace.sc_gold.kpi_stock_coverage where is_stockout) as stockout_material_days\n"
      ]
    },
    {
      "name": "adherence_weekly",
      "displayName": "Schedule adherence by week",
      "queryLines": [
        "select week_start, round(sum(on_schedule_qty) / sum(scheduled_qty), 3) as adherence\n",
        "from workspace.sc_gold.kpi_schedule_adherence group by week_start order by week_start\n"
      ]
    },
    {
      "name": "risk_weekly",
      "displayName": "Materials at risk by week",
      "queryLines": [
        "select date_trunc('week', date_day)::date as week_start,\n",
        "  count(distinct case when is_at_risk and not is_stockout then material_code end) as at_risk_in_stock,\n",
        "  count(distinct case when is_stockout then material_code end) as out_of_stock\n",
        "from workspace.sc_gold.kpi_stock_coverage group by 1 order by 1\n"
      ]
    },
    {
      "name": "risk_list",
      "displayName": "Materials at risk today",
      "queryLines": [
        "select material_code, description, material_type_name,\n",
        "  coalesce(main_supplier_name, '(produced in-house)') as supplier, is_imported,\n",
        "  cast(closing_stock as decimal(18,1)) as closing_stock, cast(safety_stock as decimal(18,1)) as safety_stock,\n",
        "  cast(on_order_qty as decimal(18,1)) as on_order_qty, cast(overdue_qty as decimal(18,1)) as overdue_qty,\n",
        "  coverage_days, days_at_risk_last_2_weeks\n",
        "from workspace.sc_gold.kpi_stockout_risk order by overdue_qty desc, coverage_days\n"
      ]
    },
    {
      "name": "suppliers",
      "displayName": "Supplier performance",
      "queryLines": [
        "select supplier_code, country, is_importer, lines_ordered, lines_completed,\n",
        "  on_time_rate, avg_lead_time_days, max_days_late\n",
        "from workspace.sc_gold.kpi_supplier_performance order by on_time_rate nulls last\n"
      ]
    }
  ],
